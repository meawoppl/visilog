{
  "schema": 1,
  "about": "Real-project differential qualification (#378). Each bench is run under iverilog and under visilog with identical sources, defines and top, and the two are compared by normalised VCD, printed output and assertion count. The projects are private and are fetched, never vendored; see tests/project_qualification.rs.",
  "reference": {
    "compile": ["iverilog", "-g2012", "-gassertions"],
    "run": ["vvp", "-n"]
  },
  "projects": {
    "MagicSchoolBus": { "repo": "meawoppl/MagicSchoolBus", "rev": "d96c531aa07af7938f5235d294040791f5cd3749" },
    "widlar": { "repo": "coup-de-foudre/widlar", "rev": "0b0632bbc8295c03fea87e5de104ce085bb58460" },
    "fpga-tesla": { "repo": "coup-de-foudre/fpga-tesla", "rev": "8ba88a1437bd74822c2db651b391595ebb005d49" }
  },
  "expectations": {
    "agree": "visilog matches the reference on every shared VCD signal, the printed output and the assertion count. This is the gate.",
    "diverge": "a known, explained divergence; reported, never gated.",
    "unsupported": "visilog stops with a named unsupported construct or limit; reported, never gated.",
    "reference_compile_failure": "iverilog itself rejects the sources; nothing to compare."
  },
  "benches": [
    { "name": "msb/CameraClock", "project": "MagicSchoolBus", "top": "CameraClock_tb", "expect": "agree",
      "sources": ["src/verilog_test/CameraClock_tb.v", "src/verilog/CameraClock.v"] },
    { "name": "msb/CameraSettings", "project": "MagicSchoolBus", "top": "CameraSettings_tb", "expect": "agree",
      "sources": ["src/verilog_test/CameraSettings_tb.v", "src/verilog/CameraSettings.v", "src/verilog/SCCBInterface.v", "src/verilog/SCCBPhy.v"] },
    { "name": "msb/CameraSetup", "project": "MagicSchoolBus", "top": "CameraSetup_tb", "expect": "agree",
      "note": "6.3 million timesteps; about two minutes in a release build",
      "sources": ["src/verilog_test/CameraSetup_tb.v", "src/verilog/CameraSetup.v", "src/verilog/CameraClock.v", "src/verilog/CameraSettings.v", "src/verilog/SCCBInterface.v", "src/verilog/SCCBPhy.v"] },
    { "name": "msb/CameraSPIBytes", "project": "MagicSchoolBus", "top": "CameraSPIBytes_tb", "expect": "agree",
      "sources": ["src/verilog_test/CameraSPIBytes_tb.v", "src/verilog/CameraSPIBytes.v"] },
    { "name": "msb/CameraSPIReader", "project": "MagicSchoolBus", "top": "CameraSPIReader_tb", "expect": "agree",
      "note": "the testbench's own check fails under iverilog too (ERROR: expected 4 bytes, got 8); visilog agrees with it",
      "sources": ["src/verilog_test/CameraSPIReader_tb.v", "src/verilog/CameraSPIReader.v", "src/verilog/CameraSPIBytes.v", "src/verilog/LinearizedMemory.v", "src/verilog/YUVSampler.v"] },
    { "name": "msb/CameraTriggerSync", "project": "MagicSchoolBus", "top": "CameraTriggerSync_tb", "expect": "agree",
      "sources": ["src/verilog_test/CameraTriggerSync_tb.v", "src/verilog/CameraTriggerSync.v"] },
    { "name": "msb/FakeImageSource", "project": "MagicSchoolBus", "top": "FakeImageSource_tb", "expect": "agree",
      "sources": ["src/verilog_test/FakeImageSource_tb.v", "src/verilog/FakeImageSource.v"] },
    { "name": "msb/LinearizedMemory", "project": "MagicSchoolBus", "top": "LinearizedMemory_tb", "expect": "agree",
      "sources": ["src/verilog_test/LinearizedMemory_tb.v", "src/verilog/LinearizedMemory.v"] },
    { "name": "msb/Radio", "project": "MagicSchoolBus", "top": "Radio_tb", "expect": "agree",
      "sources": ["src/verilog_test/Radio_tb.v", "src/verilog/ByteCounter.v", "src/verilog/Radio.v", "src/verilog/RadioTxBuffer.v", "src/verilog/Spi.v"] },
    { "name": "msb/SCCBInterface", "project": "MagicSchoolBus", "top": "SCCBInterface_tb", "expect": "agree",
      "sources": ["src/verilog_test/SCCBInterface_tb.v", "src/verilog/SCCBInterface.v"] },
    { "name": "msb/YUVSampler", "project": "MagicSchoolBus", "top": "YUVSampler_tb", "expect": "agree",
      "sources": ["src/verilog_test/YUVSampler_tb.v", "src/verilog/YUVSampler.v"] },
    { "name": "msb/UartRx", "project": "MagicSchoolBus", "top": "UartRx_tb", "expect": "reference_compile_failure",
      "note": "UartRx.v declares dataValid and rxByte twice, which iverilog 12.0 rejects",
      "sources": ["src/verilog_test/UartRx_tb.v", "src/verilog/UartRx.v"] },
    { "name": "msb/UartTx", "project": "MagicSchoolBus", "top": "UartTx_tb", "expect": "reference_compile_failure",
      "note": "UartTx.v declares done twice, which iverilog 12.0 rejects",
      "sources": ["src/verilog_test/UartTx_tb.v", "src/verilog/UartTx.v"] },
    { "name": "widlar/MaxDetector", "project": "widlar", "top": "MaxDetector_tb", "expect": "agree",
      "sources": ["tesla_ctl/fpga_test/MaxDetector_tb.v", "tesla_ctl/fpga/MaxDetector.v"] },
    { "name": "widlar/MidiClock", "project": "widlar", "top": "MidiClock_tb", "expect": "agree",
      "sources": ["tesla_ctl/fpga_test/MidiClock_tb.v", "tesla_ctl/fpga/MidiClock.v"] },
    { "name": "widlar/MidiNoteTick", "project": "widlar", "top": "MidiNoteTick_tb", "expect": "agree",
      "sources": ["tesla_ctl/fpga_test/MidiNoteTick_tb.v", "tesla_ctl/fpga/MidiNoteTick.v", "tesla_ctl/fpga/MidiNote.v"] },
    { "name": "widlar/PseudoSine", "project": "widlar", "top": "PseudoSine_tb", "expect": "agree",
      "sources": ["tesla_ctl/fpga_test/PseudoSine_tb.v", "tesla_ctl/fpga/PseudoSine.v"] },
    { "name": "widlar/PulseGenerator", "project": "widlar", "top": "PulseGenerator_tb", "expect": "agree",
      "note": "depends on iverilog's same-edge wake order: the testbench writes i_pulse with a blocking assignment on the edge the design samples it",
      "sources": ["tesla_ctl/fpga_test/PulseGenerator_tb.v", "tesla_ctl/fpga/PulseGenerator.v"] },
    { "name": "widlar/memory", "project": "widlar", "top": "memory_tb", "expect": "agree",
      "note": "the testbench's own checks fail under iverilog too; instantiates SB_SPRAM256KA from the ice40 cell library",
      "sources": ["tesla_ctl/fpga_test/memory_tb.v", "tesla_ctl/fpga/memory.v", "tesla_ctl/fpga/spi.v", "tesla_ctl/fpga/sync_ss.v", "tesla_ctl/fpga/toggle_to_strobe.v"] },
    { "name": "widlar/spi", "project": "widlar", "top": "spi_tb", "expect": "diverge",
      "note": "a race the LRM leaves open: the testbench writes i_mosi with a blocking assignment on the edge the design reads rx_data = {rx_buffer, i_mosi}, and iverilog's vvp propagates that concatenation synchronously where visilog settles continuous assignments between rounds. The testbench's own check fails under iverilog as well",
      "sources": ["tesla_ctl/fpga_test/spi_tb.v", "tesla_ctl/fpga/spi.v", "tesla_ctl/fpga/sync_ss.v", "tesla_ctl/fpga/toggle_to_strobe.v"] },
    { "name": "widlar/MidiSequencer", "project": "widlar", "top": "MidiSequencer_tb", "expect": "reference_compile_failure",
      "note": "MidiSequencer.v has a superfluous comma in its port list, which iverilog 12.0 rejects",
      "sources": ["tesla_ctl/fpga_test/MidiSequencer_tb.v", "tesla_ctl/fpga/MidiSequencer.v"] },
    { "name": "tesla/led", "project": "fpga-tesla", "top": "led_tb", "expect": "unsupported",
      "note": "waits 10^7 seconds beside the 1ps cell library, 10^19 clock ticks, past the signed 64-bit clock (iverilog's is unsigned)",
      "sources": ["src/verilog_test/led_tb.v", "src/verilog/led.v"] }
  ],
  "common": {
    "defines": [["NO_ICE40_DEFAULT_ASSIGNMENTS", "1"]],
    "cell_library": "ice40/cells_sim.v"
  }
}
